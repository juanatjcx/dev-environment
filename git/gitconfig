# Shared Git preferences, installed to ~/.config/git/shared.config and
# included from ~/.gitconfig. Identities live in the per-account files.
[core]
	editor = vim
	excludesFile = ~/.config/git/ignore
[init]
	defaultBranch = main
[push]
	# The first push of a new branch creates and tracks it on origin.
	autoSetupRemote = true
[pull]
	# Never create a merge commit on pull; rebase or merge deliberately.
	ff = only
[fetch]
	# Drop remote-tracking branches deleted on the server.
	prune = true
[merge]
	# Show the common ancestor in conflicts. (zdiff3 is tidier but makes
	# Git older than 2.35, such as Ubuntu 22.04's, fail on checkout.)
	conflictStyle = diff3
