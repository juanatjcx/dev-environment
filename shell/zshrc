export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
ZSH_THEME="developer"
ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-zsh"
mkdir -p "$ZSH_CACHE_DIR"
ZSH_COMPDUMP="$ZSH_CACHE_DIR/.zcompdump-$ZSH_VERSION"
export ZSHZ_DATA="$ZSH_CACHE_DIR/z-directory-history"
zstyle ':omz:update' mode reminder
CASE_SENSITIVE=false
zstyle ':completion:*' menu select
zstyle ':completion:*' list-colors 'di=34' 'ln=36' 'ex=32'
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'

plugins=(git z)
[[ "$OSTYPE" == darwin* ]] && plugins+=(macos)
for plugin in zsh-autosuggestions zsh-syntax-highlighting; do
  [[ -d "${ZSH_CUSTOM:-$ZSH/custom}/plugins/$plugin" ]] && plugins+=($plugin)
done
if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  print -u2 'Oh My Zsh missing; run scripts/bootstrap.sh first.'
  autoload -Uz compinit
  compinit
fi

export REPOS_HOME="${REPOS_HOME:-$HOME/repos}"
export REPOS_OWNER="${REPOS_OWNER:-juanatjcx}"
export MY_REPOS="${MY_REPOS:-$REPOS_HOME/$REPOS_OWNER}"
export EDITOR="${EDITOR:-vim}"
export VISUAL="${VISUAL:-$EDITOR}"
typeset -U path
path=("$HOME/.local/bin" $path)
# Support Docker Desktop's user-level CLI installation as well.
[[ -d "$HOME/.docker/bin" ]] && path=("$HOME/.docker/bin" $path)
if [[ "$OSTYPE" == darwin* && -d /Applications/Docker.app/Contents/Resources/bin ]]; then
  path+=(/Applications/Docker.app/Contents/Resources/bin)
fi
# Homebrew gcloud-cli puts extra `gcloud components` binaries here.
[[ -n "${HOMEBREW_PREFIX:-}" && -d "$HOMEBREW_PREFIX/share/google-cloud-sdk/bin" ]] &&
  path+=("$HOMEBREW_PREFIX/share/google-cloud-sdk/bin")
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_SPACE HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS SHARE_HISTORY
setopt INTERACTIVE_COMMENTS
bindkey -e
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^R' history-incremental-search-backward
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search

# Homebrew nvm is a compatibility choice matching this machine.
# Upstream nvm installation at ~/.nvm is supported too.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  source "$NVM_DIR/nvm.sh"
elif (( $+commands[brew] )); then
  nvm_prefix="$(brew --prefix)/opt/nvm"
  [[ -s "$nvm_prefix/nvm.sh" ]] && source "$nvm_prefix/nvm.sh"
  unset nvm_prefix
fi

# Follow project pins when changing directories; never install runtimes implicitly.
load_project_node() {
  (( $+functions[nvm] )) || return 0
  local nvmrc selected
  nvmrc="$(nvm_find_nvmrc)"
  if [[ -n "$nvmrc" ]]; then
    selected="$(nvm version "$(cat "$nvmrc")")"
    if [[ "$selected" == N/A ]]; then
      print -u2 "Node from $nvmrc is missing; run nvm install in that project."
    elif [[ "$(nvm current)" != "$selected" ]]; then
      nvm use --silent
    fi
  elif [[ "$(nvm current)" != "$(nvm version default)" ]]; then
    nvm use --silent default
  fi
  return 0
}
autoload -Uz add-zsh-hook
add-zsh-hook chpwd load_project_node
load_project_node
# Fuzzy history and file selection (installed with the baseline).
if [[ -o zle && -t 0 ]] && (( $+commands[fzf] )); then
  source <(fzf --zsh)
fi

alias repos='cd "$REPOS_HOME"'
alias myrepos='cd "$MY_REPOS"'
alias ll='ls -lah'
alias ..='cd ..'
alias ...='cd ../..'
alias reload='source "$HOME/.zshrc"'
(( $+commands[lsof] )) && alias ports='lsof -nP -iTCP -sTCP:LISTEN'
repo() {
  if (( $# > 1 )) || [[ "${1:-}" == */* || "${1:-}" == .. ]]; then
    print -u2 'Usage: repo [directory-name]'
    return 2
  fi
  builtin cd -- "$MY_REPOS${1:+/$1}"
}
_repo() {
  local -a names
  names=("$MY_REPOS"/*(/N:t))
  _describe 'repository' names
}
compdef _repo repo
# Route repository-scoped gh commands without changing the global active account.
# Authentication management and explicit environment credentials pass through.
gh() {
  local account token
  if [[ "${1:-}" == auth || -n "${GH_TOKEN:-}${GITHUB_TOKEN:-}${GH_HOST:-}" ]]; then
    command gh "$@"
    return $?
  fi
  account="$(git config --get dev.githubAccount 2>/dev/null)"
  case "$account" in
    juanatjcx|juanmicrosoft)
      token="$(command gh auth token --hostname github.com --user "$account")" || {
        print -u2 "Authenticate GitHub account $account with gh auth login first."
        return 1
      }
      GH_TOKEN="$token" command gh "$@"
      ;;
    *) command gh "$@" ;;
  esac
}
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
true
