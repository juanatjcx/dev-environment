# Login-shell Homebrew environment: Apple Silicon, Intel Mac, Linux/WSL.
for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  if [[ -x "$brew_bin" ]]; then
    eval "$("$brew_bin" shellenv)"
    break
  fi
done
# Homebrew .NET apphosts need an explicit runtime root.
if [[ -n "${HOMEBREW_PREFIX:-}" && -x "$HOMEBREW_PREFIX/opt/dotnet/libexec/dotnet" ]]; then
  export DOTNET_ROOT="${DOTNET_ROOT:-$HOMEBREW_PREFIX/opt/dotnet/libexec}"
fi
[[ -r "$HOME/.zprofile.local" ]] && source "$HOME/.zprofile.local"
